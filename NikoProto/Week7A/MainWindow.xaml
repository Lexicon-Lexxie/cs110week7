<Window x:Class="GreenwardGuide.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Greenward Field Guide"
        Height="700"
        Width="1000"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#E8F0E3">

        <!-- HEADER -->
        <Border Background="#294936"
                Height="80"
                VerticalAlignment="Top">

            <TextBlock Text="GREENWARD FIELD GUIDE"
                       Foreground="White"
                       FontSize="28"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>
        </Border>


        <!-- MAIN CONTENT -->
        <Grid Margin="30,110,30,90">

            <!-- HOME PAGE -->
            <StackPanel x:Name="HomePage"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <TextBlock Text="Greenward: A Guide for New Garden Operators"
                           FontSize="36"
                           FontWeight="Bold"
                           Foreground="#294936"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Offline illustrated guide for the garden crew"
                           FontSize="18"
                           Margin="0,10,0,30"
                           HorizontalAlignment="Center"/>

                <Button Content="START GUIDE"
                        Width="250"
                        Height="60"
                        FontSize="20"
                        Click="StartGuide_Click"/>
            </StackPanel>


            <!-- MAP PAGE -->
            <StackPanel x:Name="MapPage"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center">

                <TextBlock x:Name="MapTitle"
                           Text="Arrival"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#294936"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <Border Background="White"
                        BorderBrush="#294936"
                        BorderThickness="2"
                        Width="700"
                        Height="400">
                    <Image x:Name="MapImage"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                </Border>

                <TextBlock x:Name="MapDescription"
                           Text="Follow the marked route from the protected pods to the garden area."
                           FontSize="17"
                           Margin="0,15,0,0"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"/>
            </StackPanel>


            <!-- GUIDE PAGE -->
            <StackPanel x:Name="GuidePage"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center">

                <TextBlock x:Name="GuideTitle"
                           Text="Garden Guide"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#294936"
                           HorizontalAlignment="Center"/>

                <Border Background="White"
                        BorderBrush="#294936"
                        BorderThickness="2"
                        Width="600"
                        Height="300"
                        Margin="0,20">

                    <Image x:Name="GuideImageControl"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                </Border>

                <TextBlock x:Name="GuideDescription"
                           Text="Guide information goes here."
                           FontSize="18"
                           Width="650"
                           TextWrapping="Wrap"
                           TextAlignment="Center"/>

                <!-- SCREEN CAPTURE CONTROLS -->
                <Separator Margin="0,18"/>
                <TextBlock Text="SCREEN CAPTURE / Primary display"
                           FontSize="16"
                           Foreground="#294936"
                           Margin="0,10,0,4"/>

                <WrapPanel Margin="0,8">
                    <Button Content="_Capture screen"
                            Click="CaptureButton_Click"
                            Padding="14,8"
                            Margin="0,0,8,8"/>
                    <Button x:Name="SaveCaptureButton"
                            Content="_Save PNG"
                            Click="SaveCaptureButton_Click"
                            IsEnabled="False"
                            Padding="14,8"
                            Margin="0,0,8,8"/>
                    <Button x:Name="ClearCaptureButton"
                            Content="C_lear"
                            Click="ClearCaptureButton_Click"
                            IsEnabled="False"
                            Padding="14,8"
                            Margin="0,0,8,8"/>
                </WrapPanel>

                <Image x:Name="CapturePreview"
                       Height="140"
                       Stretch="Uniform"
                       AutomationProperties.Name="Captured screen preview"
                       Margin="0,6"/>

                <TextBlock x:Name="StatusText"
                           Text=""
                           FontSize="13"
                           Foreground="#294936"
                           Margin="0,8,0,0"/>
            </StackPanel>

        </Grid>


        <!-- NAVIGATION BUTTONS -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,25">

            <Button x:Name="BackButton"
                    Content="← BACK"
                    Width="130"
                    Height="45"
                    Margin="5"
                    Click="BackButton_Click"/>

            <Button x:Name="NextButton"
                    Content="NEXT →"
                    Width="130"
                    Height="45"
                    Margin="5"
                    Click="NextButton_Click"/>

            <Button Content="HOME"
                    Width="130"
                    Height="45"
                    Margin="5"
                    Click="HomeButton_Click"/>
        </StackPanel>

    </Grid>
</Window>